{
  "name": "@trythursday/thursday-mark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh brand-plane plugin that replaces the dolphin mark with Thursday's animated mark in the web UI (client half) and serves the Thursday favicon and web app manifest from B2's export set (host half), with every colour generated from @trythursday/tokens.",
  "license": "MIT",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./host": "./src/host.ts"
  },
  "dependencies": {
    "@trythursday/tokens": "workspace:*"
  },
  "devDependencies": {
    "@trythursday/build": "workspace:*"
  },
  "scripts": {
    "test": "node scripts/link-dsh-packages.mjs && vitest run",
    "typecheck": "node scripts/link-dsh-packages.mjs && tsc -p tsconfig.json --noEmit",
    "link:dsh": "node scripts/link-dsh-packages.mjs"
  },
  "main": "./lib/host.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
