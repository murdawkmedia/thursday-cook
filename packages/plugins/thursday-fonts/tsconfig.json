{
  // The client half compiles with the classic JSX factory, like every other
  // dsh client plugin in this workspace -- see tsconfig.client.json for why.
  //
  // Like thursday-skin and thursday-thinking this project INCLUDES tests.
  // TH4's criteria are enforced by the tests, so a type error in a test is a
  // hole in the enforcement; it must fail `typecheck` rather than hide behind
  // an `exclude`.
  "extends": "../../../tsconfig.client.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
