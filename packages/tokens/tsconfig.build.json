{
  // Declaration-emit config. The runtime JS is bundled by esbuild; tsc only
  // produces the .d.ts files that dist/index.js is typed by, from src/ alone.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
