{
  // The base every Thursday package extends. It carries compiler options only:
  // each package supplies its own "include". Derived from aidos/tsconfig.json,
  // which is the stricter of the two source repositories and the one whose
  // code moves into this workspace first.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    // The dotfiles-ai plugins this workspace ports were authored under
    // tsconfig strict:false. Their sources carry hundreds of implicit-any
    // callbacks and unguarded property accesses that are correct at runtime
    // (the host bundler type-strips; the client bundler is esbuild). Keeping
    // strict:false matches the source of truth; narrowing is opt-in per file.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "files": []
}
