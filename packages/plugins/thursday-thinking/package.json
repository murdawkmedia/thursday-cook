{
  "name": "@trythursday/thursday-thinking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh client-plane plugin that replaces the \"Deep diving...\" working indicator with a rotating set of phrases in Thursday's voice, a small animated Thursday mark to their left, and a blue-to-orange gradient generated from @trythursday/tokens.",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./data/phrases.json": "./data/phrases.json"
  },
  "dependencies": {
    "@trythursday/tokens": "workspace:*"
  },
  "devDependencies": {
    "@trythursday/build": "workspace:*"
  },
  "scripts": {
    "test": "node scripts/link-dsh-packages.mjs && vitest run",
    "typecheck": "node scripts/link-dsh-packages.mjs && tsc -p tsconfig.json --noEmit",
    "link:dsh": "node scripts/link-dsh-packages.mjs"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
