# The workspace was installed against a repo-local pnpm store (.pnpm-store at
# the repository root) rather than the user-global one, and pnpm refuses to mix
# the two. The root has no .npmrc, so a `pnpm add` run from inside this package
# would pick the global store and abort with ERR_PNPM_UNEXPECTED_STORE. Point
# it back at the store the existing node_modules is already linked from.
store-dir=../../.pnpm-store
