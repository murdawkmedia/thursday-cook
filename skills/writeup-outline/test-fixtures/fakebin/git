#!/bin/sh
# Test double for git(1): answers `git -C <dir> log` with two canned commits,
# fails everything else the way git does outside a repo.
if [ "$3" = "log" ]; then
  printf 'abc123def456\0012026-09-09T07:24:00+00:00\001receipt batch 3 extracted\n'
  printf 'fff000fff000\0012026-09-09T07:24:30+00:00\001second commit in window\n'
  exit 0
fi
echo "fatal: not a git repository (or any parent up to mount point /)" >&2
exit 128
