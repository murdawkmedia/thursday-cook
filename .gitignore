# dependencies
node_modules/
.pnpm-store/

# build output
dist/
lib/
# Exception: packages/plugins/llm-pi-ai/lib is not build output — it is the
# vendored fork payload (builtin dsh-llm-pi-ai + session-affinity offer +
# Retry-After handling). There is no source to rebuild it from; the lib IS
# the source. See packages/blocks/llm-pi-ai.md.
!packages/plugins/llm-pi-ai/lib/
*.tsbuildinfo

# local state
.thursday/
*.local
.env
.env.*
!.env.example

# editor and OS
.DS_Store
*.swp
.idea/

# harness scratch and pastes
.dsh/
.dsh_better_edit/

# logs
*.log

# built artifacts never enter version control, regardless of location:
# compiled js, emitted maps, generated token output, exported brand assets.
# source is .ts/.tsx/.css and hand-written .mjs/.cjs scripts only.
packages/tokens/dist/
packages/*/generated/
assets/generated/

# throwaway install-test homes made by live install proofs
.tmp-*/

personal/
