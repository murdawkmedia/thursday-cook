{
  "name": "@trythursday/thursday-skin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh client-plane plugin that reskins the web UI in Thursday's palette by overriding dsh's own --dsw-* theme variables from a higher-specificity scope, with every value generated from @trythursday/tokens.",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@trythursday/tokens": "workspace:*"
  },
  "devDependencies": {
    "@trythursday/build": "workspace:*"
  },
  "scripts": {
    "test": "node scripts/link-dsh-packages.mjs && vitest run",
    "typecheck": "node scripts/link-dsh-packages.mjs && tsc -p tsconfig.json --noEmit",
    "link:dsh": "node scripts/link-dsh-packages.mjs"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
