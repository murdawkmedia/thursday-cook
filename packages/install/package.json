{
  "name": "@trythursday/install",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Thursday install engine: block schema, action registry, block loader.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "execa": "^10.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "memfs": "^4.71.0"
  }
}
