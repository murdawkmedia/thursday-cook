{
  "name": "@trythursday/thursday-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh host+client plugin that runs the Teach-Me-Thursday tour as structured YAML steps with derived completion, durable progress, an agent lookup tool, and a visible shell.overlay panel with a four-rectangle spotlight.",
  "license": "MIT",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./data/steps.yaml": "./data/steps.yaml"
  },
  "dependencies": {
    "@trythursday/tokens": "workspace:*"
  },
  "devDependencies": {
    "@trythursday/build": "workspace:*"
  },
  "scripts": {
    "steps": "node scripts/generate-steps.mjs",
    "link:dsh": "node scripts/link-dsh-packages.mjs",
    "test": "node scripts/link-dsh-packages.mjs && vitest run",
    "typecheck": "node scripts/link-dsh-packages.mjs && tsc -p tsconfig.json --noEmit"
  },
  "main": "./lib/host.js",
  "files": [
    "lib",
    "data",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
